<Window x:Class="Flamoris.Cutwork.App.Generation.ImageRepairWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="1100" Height="820" MinWidth="850" MinHeight="620"
        WindowStartupLocation="CenterOwner" Background="#FFF6F3F1">
    <DockPanel Margin="16">
        <TextBlock x:Name="Explanation" DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,12" />
        <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <TextBlock x:Name="Status" TextWrapping="Wrap" MinHeight="44" MaxHeight="110" />
            <WrapPanel HorizontalAlignment="Right">
                <Button x:Name="GenerateButton" Click="Generate_Click" Padding="16,7" Margin="4" IsEnabled="False" />
                <Button x:Name="CancelJobButton" Click="CancelJob_Click" Padding="16,7" Margin="4" IsEnabled="False" />
                <Button x:Name="ApplyButton" Click="Apply_Click" Padding="16,7" Margin="4" IsEnabled="False" />
                <Button x:Name="CloseButton" Click="Close_Click" Padding="16,7" Margin="4" />
            </WrapPanel>
        </StackPanel>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="340"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <StackPanel x:Name="LoginPanel">
                        <TextBlock x:Name="ServerLabel" Margin="0,4"/>
                        <TextBox x:Name="Server" MinHeight="28" MaxLength="2048"/>
                        <TextBlock x:Name="EmailLabel" Margin="0,8,0,4"/>
                        <TextBox x:Name="Email" MinHeight="28" MaxLength="256"/>
                        <TextBlock x:Name="PasswordLabel" Margin="0,8,0,4"/>
                        <PasswordBox x:Name="Password" MinHeight="28" MaxLength="256"/>
                        <Button x:Name="ConnectButton" Click="Connect_Click" Margin="0,10,0,16" Padding="10,6"/>
                    </StackPanel>
                    <TextBlock x:Name="WorkflowLabel" Margin="0,4"/>
                    <ComboBox x:Name="Workflow" MinHeight="30" SelectionChanged="Workflow_Changed" IsEnabled="False"/>
                    <StackPanel x:Name="ParameterPanel" Margin="0,8,0,0"/>
                </StackPanel>
            </ScrollViewer>
            <Grid Grid.Column="2">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
                <TextBlock x:Name="ReferenceLabel" Margin="0,4"/>
                <Border Grid.Row="1" Background="#FF333438" Padding="8"><Image x:Name="Reference" Stretch="Uniform"/></Border>
                <TextBlock x:Name="ComparisonLabel" Grid.Row="2" Margin="0,12,0,4"/>
                <Grid Grid.Row="3">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <Border Background="#FF333438" Padding="6"><Image x:Name="Before" Stretch="Uniform"/></Border>
                    <Border Grid.Column="2" Background="#FF333438" Padding="6"><Image x:Name="After" Stretch="Uniform"/></Border>
                </Grid>
            </Grid>
        </Grid>
    </DockPanel>
</Window>

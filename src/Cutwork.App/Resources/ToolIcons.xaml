            <GeometryDrawing Pen="{StaticResource Icon.RedPen}" Geometry="M11,4 L17,4 M14,1 L14,7" />
        </DrawingGroup></DrawingImage.Drawing>
    </DrawingImage>
    <DrawingImage x:Key="Icon.Blur">

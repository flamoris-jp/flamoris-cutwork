            <GeometryDrawing Brush="{StaticResource Icon.Red}" Geometry="M8,15 A4,4 0 0 0 12,19 L12,15 Z" />
        </DrawingGroup></DrawingImage.Drawing>
    </DrawingImage>
    <DrawingImage x:Key="Icon.Smudge">
        <DrawingImage.Drawing><DrawingGroup>

        </DrawingGroup></DrawingImage.Drawing>
    </DrawingImage>
    <DrawingImage x:Key="Icon.Delete">
        <DrawingImage.Drawing><DrawingGroup>
            <GeometryDrawing Pen="{StaticResource Icon.CharcoalPen}" Geometry="M7,7 L8,21 16,21 17,7 M5,7 L19,7 M9,4 L15,4" />
            <GeometryDrawing Pen="{StaticResource Icon.RedPen}" Geometry="M10,11 L14,17 M14,11 L10,17" />
        </DrawingGroup></DrawingImage.Drawing>
    </DrawingImage>
    <DrawingImage x:Key="Icon.Up">
        <DrawingImage.Drawing><DrawingGroup>
            <GeometryDrawing Pen="{StaticResource Icon.CharcoalPen}" Geometry="M5,17 L19,17 M7,12 L17,12" />
            <GeometryDrawing Pen="{StaticResource Icon.RedPen}" Geometry="M12,10 L12,3 M8,7 L12,3 16,7" />
        </DrawingGroup></DrawingImage.Drawing>
    </DrawingImage>
    <DrawingImage x:Key="Icon.Down">
        <DrawingImage.Drawing><DrawingGroup>
            <GeometryDrawing Pen="{StaticResource Icon.CharcoalPen}" Geometry="M5,7 L19,7 M7,12 L17,12" />
            <GeometryDrawing Pen="{StaticResource Icon.RedPen}" Geometry="M12,14 L12,21 M8,17 L12,21 16,17" />
        </DrawingGroup></DrawingImage.Drawing>
    </DrawingImage>
</ResourceDictionary>

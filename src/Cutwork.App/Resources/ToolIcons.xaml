<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Repository-owned FLAMORIS icon set: charcoal construction with restrained red accents. -->
    <SolidColorBrush x:Key="Icon.Charcoal" Color="#FF2D3236" />
    <SolidColorBrush x:Key="Icon.Red" Color="#FFD20B3A" />
    <Pen x:Key="Icon.CharcoalPen" Brush="{StaticResource Icon.Charcoal}" Thickness="2.2"
         StartLineCap="Round" EndLineCap="Round" LineJoin="Round" />
    <Pen x:Key="Icon.RedPen" Brush="{StaticResource Icon.Red}" Thickness="2.2"
         StartLineCap="Round" EndLineCap="Round" LineJoin="Round" />

    <DrawingImage x:Key="Icon.Open">
        <DrawingImage.Drawing><DrawingGroup>
            <GeometryDrawing Pen="{StaticResource Icon.CharcoalPen}" Geometry="M3,7 L9,7 11,5 15,5 17,7 21,7 19,19 5,19 Z" />
            <GeometryDrawing Pen="{StaticResource Icon.RedPen}" Geometry="M10,4 L16,4" />
        </DrawingGroup></DrawingImage.Drawing>
    </DrawingImage>
    <DrawingImage x:Key="Icon.Save">
        <DrawingImage.Drawing><DrawingGroup>
            <GeometryDrawing Pen="{StaticResource Icon.CharcoalPen}" Geometry="M5,3 L19,3 21,5 21,21 3,21 3,3 Z M7,3 L7,9 17,9 17,3 M7,15 L17,15 17,21 7,21 Z" />
            <GeometryDrawing Pen="{StaticResource Icon.RedPen}" Geometry="M9,18 L15,18" />
        </DrawingGroup></DrawingImage.Drawing>
    </DrawingImage>
    <DrawingImage x:Key="Icon.SaveAs">
        <DrawingImage.Drawing><DrawingGroup>
            <GeometryDrawing Pen="{StaticResource Icon.CharcoalPen}" Geometry="M4,3 L17,3 20,6 20,13 M8,3 L8,8 15,8 15,3" />
            <GeometryDrawing Pen="{StaticResource Icon.RedPen}" Geometry="M9,19 L18,10 21,13 12,22 8,22 Z" />
        </DrawingGroup></DrawingImage.Drawing>
    </DrawingImage>
    <DrawingImage x:Key="Icon.Undo">
        <DrawingImage.Drawing><DrawingGroup>
            <GeometryDrawing Pen="{StaticResource Icon.CharcoalPen}" Geometry="M9,7 L4,11 9,15 M5,11 L14,11 C19,11 21,14 21,19" />
            <GeometryDrawing Pen="{StaticResource Icon.RedPen}" Geometry="M4,11 L7,11" />
        </DrawingGroup></DrawingImage.Drawing>
    </DrawingImage>
    <DrawingImage x:Key="Icon.Redo">
        <DrawingImage.Drawing><DrawingGroup>
            <GeometryDrawing Pen="{StaticResource Icon.CharcoalPen}" Geometry="M15,7 L20,11 15,15 M19,11 L10,11 C5,11 3,14 3,19" />
            <GeometryDrawing Pen="{StaticResource Icon.RedPen}" Geometry="M17,11 L20,11" />
        </DrawingGroup></DrawingImage.Drawing>
    </DrawingImage>
    <DrawingImage x:Key="Icon.Part">
        <DrawingImage.Drawing><DrawingGroup>
            <GeometryDrawing Pen="{StaticResource Icon.CharcoalPen}" Geometry="M5,5 L18,4 21,11 16,20 6,18 3,10 Z" />
            <GeometryDrawing Brush="{StaticResource Icon.Red}" Geometry="M2,8 L6,8 6,12 2,12 Z M17,9 L21,9 21,13 17,13 Z" />
        </DrawingGroup></DrawingImage.Drawing>
    </DrawingImage>
    <DrawingImage x:Key="Icon.Mask">
        <DrawingImage.Drawing><DrawingGroup>
            <GeometryDrawing Pen="{StaticResource Icon.CharcoalPen}" Geometry="M3,5 L8,5 M3,5 L3,10 M21,5 L16,5 M21,5 L21,10 M3,19 L8,19 M3,19 L3,14 M21,19 L16,19 M21,19 L21,14" />
            <GeometryDrawing Pen="{StaticResource Icon.RedPen}" Geometry="M8,9 C10,6 16,7 17,11 C18,15 14,18 10,16 C7,15 6,12 8,9 Z" />
        </DrawingGroup></DrawingImage.Drawing>
    </DrawingImage>
    <DrawingImage x:Key="Icon.Patch">
        <DrawingImage.Drawing><DrawingGroup>
            <GeometryDrawing Pen="{StaticResource Icon.CharcoalPen}" Geometry="M5,4 L16,4 20,8 20,19 5,19 Z M16,4 L16,8 20,8" />
            <GeometryDrawing Pen="{StaticResource Icon.RedPen}" Geometry="M9,9 L14,9 14,14 9,14 Z M7,16 L17,16" />
        </DrawingGroup></DrawingImage.Drawing>
    </DrawingImage>
    <DrawingImage x:Key="Icon.Clone">
        <DrawingImage.Drawing><DrawingGroup>

<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <UseWPF>true</UseWPF>
    <RootNamespace>Flamoris.Cutwork.App</RootNamespace>
    <AssemblyName>Cutwork</AssemblyName>
    <ApplicationIcon>Assets\cutwork.ico</ApplicationIcon>
    <Product>FLAMORIS Cutwork</Product>
    <Description>A small, fast Windows editor for illustration cutout and repair.</Description>
    <VersionPrefix>0.1.0</VersionPrefix>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
    <InformationalVersion>0.1.0</InformationalVersion>
    <Copyright>Copyright © 2026 FLAMORIS contributors</Copyright>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../dependencies/flamoris-capture/src/Flamoris.Capture.Wpf/Flamoris.Capture.Wpf.csproj" />
    <PackageReference Include="Flamoris.Logging" Version="1.0.0" />
    <PackageReference Include="Flamoris.Mcp.Core" Version="1.3.1" />
    <ProjectReference Include="..\Cutwork.Mcp\Cutwork.Mcp.csproj" />
    <ProjectReference Include="..\Cutwork.Core\Cutwork.Core.csproj" />
    <ProjectReference Include="..\Cutwork.Imaging\Cutwork.Imaging.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Flamoris.Mcp.Wpf" Version="1.3.1" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets/cutwork.ico" />
  </ItemGroup>
</Project>
